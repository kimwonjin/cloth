# Copy to .env.local and fill in values from
# Supabase Dashboard > Project Settings > API (or "Connect" button).
# EXPO_PUBLIC_ vars are bundled into the app, so only put public keys here.
# Never put the service_role / secret key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key both work.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
